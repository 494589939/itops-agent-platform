# ITOps Agent Platform - Frontend
# Multi-stage build optimized for production (no remote Docker Hub pulls needed)
# Build: docker build -f docker/Dockerfile.frontend -t itops-frontend:prod .
#
# NOTE: Explicitly use node:20.19.5-bookworm-slim for BOTH builder and runtime
#       (this tag exists in local Docker image cache, avoids re-pulling from
#        unreachable Docker Hub registry). For runtime we install nginx via
#        apt (from Aliyun mirror) instead of using the separate nginx:alpine image.

# ============================================================
# Stage 1: Builder (Vite production build + TypeScript check)
# ============================================================
FROM node:20.19.5-bookworm-slim AS builder

# Use Aliyun Debian mirror for main packages, USTC for security (Aliyun debian-security intermittently returns HTTP 502)
# Note: Must use HTTP (not HTTPS) because node:20-slim lacks ca-certificates at this layer
RUN sed -i 's|http://deb.debian.org/debian|http://mirrors.aliyun.com/debian|g; s|http://security.debian.org/debian-security|http://mirrors.ustc.edu.cn/debian-security|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update --allow-releaseinfo-change && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Enable npm cache for faster installs
ENV npm_config_cache=/app/.npm-cache

# Copy package files first for better layer caching
COPY frontend/package.json frontend/package-lock.json ./

# Install dependencies using Aliyun npm mirror (npmmirror.com) — no registry-1.docker.io contact
RUN npm config set registry https://registry.npmmirror.com \
    && npm ci --no-audit --no-fund

# Copy source code
COPY frontend/ ./

# Type check first, then production Vite build
RUN npx tsc --noEmit
RUN npx vite build

# ============================================================
# Stage 2: Production (Node slim + apt-installed nginx)
# ============================================================
# Using the SAME base image as builder (already cached locally), install nginx
# via apt from Aliyun mirror instead of pulling the separate nginx:alpine image.
# Functionally equivalent to nginx:alpine — same nginx binary, same config file.
FROM node:20.19.5-bookworm-slim

LABEL maintainer="谭策 <huawei_network@foxmail.com>" \
    org.opencontainers.image.title="ITOps Agent Platform Frontend" \
    org.opencontainers.image.description="Enterprise IT Operations Multi-Agent Automation Platform - Web UI (nginx hosted)" \
    org.opencontainers.image.source="https://github.com/494589939/itops-agent-platform" \
    org.opencontainers.image.licenses="MPL-2.0" \
    org.opencontainers.image.vendor="谭策" \
    org.opencontainers.image.url="https://www.zjzwfw.cloud/ITOpsAgentinfo"

# Use Aliyun Debian mirror for main packages, USTC for security (Aliyun debian-security intermittently returns HTTP 502)
RUN sed -i 's|http://deb.debian.org/debian|http://mirrors.aliyun.com/debian|g; s|http://security.debian.org/debian-security|http://mirrors.ustc.edu.cn/debian-security|g' /etc/apt/sources.list.d/debian.sources \
    # Install nginx (stable Debian package), curl + wget (for health checks & debugging)
    && apt-get update --allow-releaseinfo-change \
    && apt-get install -y --no-install-recommends nginx ca-certificates curl wget \
    # Cleanup apt cache to shrink image size
    && rm -rf /var/lib/apt/lists/* \
    # Remove Debian default nginx site config (we supply our own)
    && rm -f /etc/nginx/sites-enabled/default /etc/nginx/conf.d/default.conf 2>/dev/null || true

# Copy OUR nginx configuration (includes /api & /socket.io proxy to backend,
# SPA routing, security headers, gzip, cache strategy — identical behavior to
# what nginx:alpine image was doing)
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy production static files (built Vite dist/) from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# nginx pid and temp dirs must exist before starting as non-root (nginx daemon)
RUN mkdir -p /var/cache/nginx /var/lib/nginx /run/nginx \
    && chown -R www-data:adm /var/cache/nginx /var/lib/nginx /run/nginx 2>/dev/null || true

# Create a symlink so that docker logs via "docker logs -f itops-frontend"
# correctly shows nginx access/error logs (redirect to stdout/stderr)
RUN ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log

# HTTP port for nginx (matches compose 8080:80 mapping)
EXPOSE 80

# Health check: hit nginx root, identical to old nginx:alpine healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:80/ || exit 1

# ============================================================
# PRODUCTION: Start nginx in foreground mode.
# - Reads /etc/nginx/conf.d/default.conf (= our supplied nginx.conf)
# - nginx serves dist/, proxies /api + /socket.io → backend:3001
# ============================================================
CMD ["nginx", "-g", "daemon off;"]
